rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Slots are public (shown on the schedule without login).
    // Only the admin can create, edit, or delete slots.
    match /slots/{slotId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "yanmeloa1@gmail.com";
    }

    // Registrations: names are shown publicly on the schedule,
    // but only authenticated users may create or modify records.
    match /registrations/{regId} {
      // Anyone can read (names shown on schedule for unauthenticated visitors too)
      allow read: if true;

      // Authenticated users may only create registrations for themselves
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == "ativo";

      // Users can update/cancel their own; admin can update any
      allow update: if request.auth != null
                    && (
                      resource.data.uid == request.auth.uid
                      || request.auth.token.email == "yanmeloa1@gmail.com"
                    );

      // Only admin can hard-delete documents
      allow delete: if request.auth != null
                    && request.auth.token.email == "yanmeloa1@gmail.com";
    }
  }
}
